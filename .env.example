# Copie este arquivo para .env e preencha com os valores locais.
# O arquivo .env NUNCA deve ser enviado ao GitHub.

# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True somente em desenvolvimento local
DEBUG=True

# Hosts permitidos, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# Em produção: https://seu-app.onrender.com
CSRF_TRUSTED_ORIGINS=

# Banco de dados. Sem esta variável o projeto usa SQLite (db.sqlite3).
# Exemplo PostgreSQL: postgresql://usuario:senha@host:5432/nome_banco
DATABASE_URL=

# Senha das contas de demonstração criadas por: python manage.py popular_dados
SENHA_DEMO=

# ViaCEP (opcional; já possui valores padrão)
VIACEP_TIMEOUT=5
